diff --git a/src/modrfasim.c b/src/modrfasim.c
new file mode 100644
index 0000000..2b20ef7
--- /dev/null
+++ b/src/modrfasim.c
@@ -0,0 +1,33 @@
+// Robots For All: the simulator profile's link to the robot world (ADR-0008; M4 spec 6.2).
+// _rfa_sim.call(name, value) sends a robot call to the editor. _rfa_sim.read(name) returns the
+// latest sensor answer the editor pushed in, at once: reads never wait for the editor.
+#include "py/runtime.h"
+#include "jshal.h"
+
+STATIC mp_obj_t rfa_sim_call(mp_obj_t name_in, mp_obj_t value_in) {
+    size_t len;
+    const char *name = mp_obj_str_get_data(name_in, &len);
+    mp_js_hal_robot_call(name, len, mp_obj_get_int(value_in));
+    return mp_const_none;
+}
+STATIC MP_DEFINE_CONST_FUN_OBJ_2(rfa_sim_call_obj, rfa_sim_call);
+
+STATIC mp_obj_t rfa_sim_read(mp_obj_t name_in) {
+    size_t len;
+    const char *name = mp_obj_str_get_data(name_in, &len);
+    return MP_OBJ_NEW_SMALL_INT(mp_js_hal_robot_read(name, len));
+}
+STATIC MP_DEFINE_CONST_FUN_OBJ_1(rfa_sim_read_obj, rfa_sim_read);
+
+STATIC const mp_rom_map_elem_t rfa_sim_module_globals_table[] = {
+    { MP_ROM_QSTR(MP_QSTR___name__), MP_ROM_QSTR(MP_QSTR__rfa_sim) },
+    { MP_ROM_QSTR(MP_QSTR_call), MP_ROM_PTR(&rfa_sim_call_obj) },
+    { MP_ROM_QSTR(MP_QSTR_read), MP_ROM_PTR(&rfa_sim_read_obj) },
+};
+STATIC MP_DEFINE_CONST_DICT(rfa_sim_module_globals, rfa_sim_module_globals_table);
+
+// Listed in MICROPY_PORT_BUILTIN_MODULES (mpconfigport.h), like the port's own modules.
+const mp_obj_module_t rfa_sim_module = {
+    .base = { &mp_type_module },
+    .globals = (mp_obj_dict_t *)&rfa_sim_module_globals,
+};
