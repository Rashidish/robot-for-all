--- a/src/simulator.ts
+++ b/src/simulator.ts
@@ -21,4 +21,23 @@ declare global {
 
 const fs = new FileSystem();
 const board = createBoard(new Notifications(window.parent), fs);
+
+// Robot For All: browsers only let sound start after a tap in the same page. The editor makes
+// (or reuses) an AudioContext during its own Run tap and hands it over with rfaStartAudio(ctx),
+// because a tap in the editor doesn't count as a tap inside this frame on every browser (it
+// works on Android Chrome but not on Windows Chrome). Any tap or key on the board also turns
+// sound on. rfaAudioState() lets our tests check the sound engine is running.
+type RfaAudio = { context?: AudioContext };
+const rfaStartAudio = (fromEditor?: AudioContext) => {
+  const audio = board.audio as unknown as RfaAudio;
+  if (fromEditor && audio.context?.state !== "running") {
+    audio.context = fromEditor;
+  }
+  void board.audio.createAudioContextFromUserInteraction();
+};
+(window as unknown as Record<string, unknown>).rfaStartAudio = rfaStartAudio;
+(window as unknown as Record<string, unknown>).rfaAudioState = () =>
+  (board.audio as unknown as RfaAudio).context?.state ?? "none";
+document.addEventListener("pointerdown", () => rfaStartAudio());
+document.addEventListener("keydown", () => rfaStartAudio());
 window.addEventListener("message", createMessageListener(board));
