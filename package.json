{
  "name": "robot-for-all",
  "private": true,
  "description": "Free, low-data STEM and robotics learning platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./apps/web/src/paraglide",
    "dev": "npm run i18n && npm run dev -w apps/web",
    "build": "npm run i18n && npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run i18n && npm run typecheck -w apps/web",
    "test": "npm run i18n && vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "latest",
    "@inlang/plugin-message-format": "latest",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
