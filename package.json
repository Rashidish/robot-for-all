{
  "name": "robots-for-all",
  "private": true,
  "description": "Free, low-data STEM and robotics learning platform",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "workspaces": [
    "apps/web",
    "apps/admin"
  ],
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./apps/web/src/paraglide",
    "dev": "npm run i18n && npm run dev -w apps/web",
    "build": "npm run i18n && npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run i18n && npm run typecheck -w apps/web && npm run typecheck -w apps/admin && tsc -p packages/blocks && tsc -p packages/sim && tsc -p packages/robots && tsc -p packages/db && tsc -p packages/settings && tsc -p apps/cert && tsc -p apps/signin",
    "test": "npm run i18n && vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "build:production": "SHOW_DRAFTS=false npm run build",
    "build:admin": "npm run build -w apps/admin",
    "sheet-codes": "node scripts/sheet-codes.mjs",
    "translation-hash": "node --experimental-strip-types scripts/translation-hash.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
