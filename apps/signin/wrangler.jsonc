// The learner sign-in service (ADR-0013 and its amendment): the only holder of Supabase's JWT
// secret. Deployed by .github/workflows/deploy.yml from main only, once the owner has set it up
// (docs/deploy.md §8). Secrets (SUPABASE_URL, SUPABASE_SERVICE_KEY, SUPABASE_JWT_SECRET) are set
// with `wrangler secret put`, never written here. Logs are off.
{
  "name": "robots-for-all-signin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "robotsforall.org.za/signin/*", "zone_name": "robotsforall.org.za" }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Rate limits (Workers rate limiting): 30 tries a minute per address, 100 per class.
  "ratelimits": [
    { "name": "BY_ADDRESS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "BY_CLASS", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
  ]
}
