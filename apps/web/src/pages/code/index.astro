---
// M3 code editor (spec docs/specs/M3-code.md). Step 1: spike page.
// The Svelte editor is started from a bundled module script rather than as an Astro island,
// because island hydration adds an inline <script>
  // The editor (about 240 KB compressed) loads after the page itself, while the browser is idle.
  const target = document.getElementById('code-editor');
  const load = () => {
    if (!target) return;
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    void import('../../code/start').then(({ start }) => start(target, labels));
  };
  const whenIdle = () =>
    'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 0);
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', whenIdle, { once: true });
</script>
