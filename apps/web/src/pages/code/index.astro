---
// M3 code editor (spec docs/specs/M3-code.md). Step 1: spike page.
// The Svelte editor is mounted from a bundled module script rather than as an Astro island,
// because island hydration adds an inline <script> and <style> that our CSP blocks.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { m } from '../../i18n';

const labels = {
  workspace: m.code_workspace(),
  download: m.code_download_hex(),
  send: m.code_send(),
  working: m.code_working(),
  done: m.code_done(),
  failed: m.code_failed(),
  noUsb: m.code_no_usb()
};
---

<BaseLayout title={m.code_title()}>
  <h1>{m.code_title()}</h1>
  <p>{m.code_intro()}</p>
  <div id="code-editor" data-labels={JSON.stringify(labels)}></div>
</BaseLayout>

<script>
  import { mount } from 'svelte';
  import CodeEditor from '../../components/CodeEditor.svelte';

  const target = document.getElementById('code-editor');
  if (target) {
    mount(CodeEditor, { target, props: { labels: JSON.parse(target.dataset['labels'] ?? '{}') } });
  }
</script>
