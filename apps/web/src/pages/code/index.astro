---
// M3 code editor (spec docs/specs/M3-code.md). Step 1: spike page.
// The Svelte editor is started from a bundled module script rather than as an Astro island,
// because island hydration adds inline script and style tags that our CSP blocks.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { m } from '../../i18n';

// Every editor, block and category message, passed to the editor as data (no inline script).
const labels = Object.fromEntries(
  Object.entries(m)
    .filter(([key]) =>
      /^(code|block|category|sim|gesture|colour|math|game|world|mission|season)_|^needs_/.test(key)
    )
    .map(([key, message]) => [key, (message as () => string)()])
);
---

<BaseLayout title={m.code_title()} wide>
  <div class="app-bar">
    <h1>{m.code_title()}</h1>
    <p>{m.code_intro()}</p>
  </div>
  <div id="code-editor" data-labels={JSON.stringify(labels)}>
    <p class="loading">{m.code_loading()}</p>
  </div>
</BaseLayout>

<style>
  /* MakeCode-style colours (owner decision 2026-11-22), so learners who also use MakeCode
     at school see a familiar editor. Light only, like MakeCode. */
  .app-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-4);
    padding: var(--space-2) var(--space-4);
    background: #3454d1;
    color: #fff;
    color-scheme: light;
  }
  .app-bar h1 {
    margin: 0;
    font-size: 1.25rem;
    color: #fff;
  }
  .app-bar p {
    margin: 0;
    font-size: 0.875rem;
  }
  @media (max-width: 47.99rem) {
    .app-bar p {
      display: none;
    }
  }
  .loading {
    padding: var(--space-4);
  }
</style>

<script>
  // The editor (about 240 KB compressed) loads after the page itself, while the browser is idle.
  const target = document.getElementById('code-editor');
  const load = () => {
    if (!target) return;
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    void import('../../code/start').then(({ start }) => start(target, labels));
  };
  const whenIdle = () =>
    'requestIdleCallback' in window
      ? requestIdleCallback(load, { timeout: 1500 })
      : setTimeout(load, 0);
  if (document.readyState === 'complete') whenIdle();
  else window.addEventListener('load', whenIdle, { once: true });
</script>
