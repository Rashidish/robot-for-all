---
// Junior (Grades R–2; spec docs/specs/junior.md, ADR-0019): picture blocks on a grid. Its own page,
// so a young learner's phone doesn't download the Grade 3+ editor; the editor links to it as a tab.
// Started from a bundled module script, like the code editor (our CSP blocks inline scripts).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { localHref, m, pageLang } from '../../../i18n';
import { juniorMissions } from '../../../junior/missions';

// The page needs the boards and programs, not the planning facts (grades, term, CAPS codes): those
// are for teachers (the build checks them; teacher tools list them), and leaving them out keeps the
// page within its size budget.
const missionsForPage = juniorMissions().map((m) => {
  const page: Partial<typeof m> = { ...m };
  delete page.grades;
  delete page.term;
  delete page.caps;
  return page;
});
const SERVER_ONLY = new Set([
  'junior_title',
  'junior_intro',
  'junior_loading',
  'junior_back_to_code',
  'junior_cards_about',
  'junior_print',
  'junior_sheet_title',
  'junior_sheet_boxes',
  'junior_sheet_faces',
  'junior_sheet_stars'
]);
const labels = Object.fromEntries(
  Object.entries(m)
    // Only the words the Junior component uses: the page heading, the cards and the sheets are
    // rendered on the server, so their words needn't be sent again.
    .filter(([key]) => key.startsWith('junior_') && !SERVER_ONLY.has(key))
    // Words with a number or a square in them keep "{n}" and "{cell}", filled in on the page.
    .map(([key, message]) => [
      key,
      (message as (inputs: Record<string, string>) => string)({ n: '{n}', cell: '{cell}' })
    ])
);
---

<BaseLayout title={m.junior_title()}>
  <p class="back">
    <a href={localHref('/code/')}>← {m.junior_back_to_code()}</a>
  </p>
  <h1>{m.junior_title()}</h1>
  <p>{m.junior_intro()}</p>
  <div
    id="junior"
    data-labels={JSON.stringify(labels)}
    data-missions={JSON.stringify(missionsForPage)}
    data-language={pageLang()}
  >
    <p>{m.junior_loading()}</p>
  </div>
</BaseLayout>

<script>
  import type { Mission } from '../../../../../../packages/sim/src/junior';
  const target = document.getElementById('junior');
  if (target) {
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    const missions = JSON.parse(target.dataset['missions'] ?? '[]') as Mission[];
    const language = target.dataset['language'] ?? 'en';
    void import('../../../junior/start').then(({ start }) =>
      start(target, labels, missions, language)
    );
  }
</script>
