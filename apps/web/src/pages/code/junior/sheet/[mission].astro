---
// A Junior picture mission sheet (spec FR-6): one A4 page per mission. The board, empty boxes to
// draw the arrows in, and faces and stars to colour; no words for the child (the mission's name is
// for the adult). Printed from the mission's page or from a Junior lesson.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import JuniorBoard from '../../../../components/JuniorBoard.astro';
import PrintButton from '../../../../components/PrintButton.astro';
import { localHref, m } from '../../../../i18n';
import { juniorMissions, missionKey } from '../../../../junior/missions';
import type { Mission } from '../../../../../../../packages/sim/src/junior';
import { STAR_ICON } from '../../../../junior/icons';

export function getStaticPaths() {
  return juniorMissions().map((mission) => ({
    params: { mission: mission.id },
    props: { mission }
  }));
}
interface Props {
  mission: Mission;
}
const { mission } = Astro.props;
const name =
  (m as unknown as Record<string, () => string>)[missionKey(mission.id)]?.() ?? mission.id;
// Room for the best program and a few more blocks.
const boxes = Math.min(20, Math.max(8, mission.best + 4));
const FACES = [
  { mouth: 'M7 14c1.5 2.5 8.5 2.5 10 0', colour: '#2e7d32' },
  { mouth: 'M7.5 15.5h9', colour: '#b85c00' },
  { mouth: 'M7 16.5c1.5-2.5 8.5-2.5 10 0', colour: '#6a35b0' }
];
---

<BaseLayout title={`${name} · ${m.junior_sheet_title()}`}>
  <p class="back">
    <a href={localHref(`/code/junior/#${mission.id}`)}>← {m.junior_title()}</a>
  </p>
  <PrintButton label={m.junior_print()} />
  <article class="junior-sheet">
    <h1>{name}</h1>
    <div class="board">
      <JuniorBoard mission={mission} label={name} />
    </div>
    <div class="boxes" role="img" aria-label={m.junior_sheet_boxes()}>
      {Array.from({ length: boxes }, () => (
        <span class="box" />
      ))}
    </div>
    <div class="feel">
      <div class="faces" role="img" aria-label={m.junior_sheet_faces()}>
        {FACES.map((f) => (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" fill="none" stroke={f.colour} stroke-width="1.5" />
            <circle cx="8.5" cy="9.5" r="1.3" fill={f.colour} />
            <circle cx="15.5" cy="9.5" r="1.3" fill={f.colour} />
            <path
              d={f.mouth}
              fill="none"
              stroke={f.colour}
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        ))}
      </div>
      <div class="stars" role="img" aria-label={m.junior_sheet_stars()}>
        {[1, 2].map(() => (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={STAR_ICON} fill="none" stroke="#b85c00" stroke-width="1.2" />
          </svg>
        ))}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .junior-sheet {
    display: grid;
    gap: var(--space-4);
    max-width: 30rem;
  }
  .junior-sheet h1 {
    margin: 0;
  }
  .board :global(svg) {
    width: 100%;
    height: auto;
  }
  .boxes {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
  }
  .box {
    aspect-ratio: 1;
    border: 2px solid #b48a5a;
    border-radius: 10px;
  }
  .feel {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .faces,
  .stars {
    display: flex;
    gap: var(--space-2);
  }
  .feel svg {
    width: 56px;
    height: 56px;
  }
  @media print {
    @page {
      size: A4;
      margin: 12mm;
    }
    .back {
      display: none !important;
    }
    .junior-sheet {
      max-width: none;
      gap: 6mm;
    }
    .board {
      width: 110mm;
      margin-inline: auto;
    }
    .board :global(svg) {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .boxes {
      gap: 3mm;
      grid-template-columns: repeat(6, 24mm);
      justify-content: center;
    }
    .box {
      aspect-ratio: auto;
      height: 24mm;
    }
    .feel svg {
      width: 22mm;
      height: 22mm;
    }
  }
</style>
