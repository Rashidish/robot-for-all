---
// Confirm a school's or club's enrolment (M5 step 4b): the parent opens the emailed link,
// /enrol/confirm/#<secret>. The secret after # never reaches a server log. Off on the live site
// until "accounts" is switched on.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { m } from '../../i18n';
import { featureOn } from '../../site';
import { siteLanguages } from '../../site-languages';

const open = featureOn('accounts') || __RFA_SHOW_DRAFTS__;
const labels = Object.fromEntries(
  Object.entries(m)
    .filter(([key]) => /^(account|enrol|confirm)_/.test(key))
    .map(([key, message]) => [key, (message as () => string)()])
);
---

<BaseLayout title={m.confirm_title()}>
  <h1>{m.confirm_title()}</h1>
  {open ? (
    <div
      id="confirm"
      data-labels={JSON.stringify(labels)}
      data-languages={JSON.stringify(
        siteLanguages.map((l) => ({ code: l.code, native: l.native }))
      )}
    >
      <p>{m.account_loading()}</p>
    </div>
  ) : (
    <>
      <p>{m.enrol_soon()}</p>
      <p>
        <a href="/lessons/">{m.home_browse()}</a>
      </p>
    </>
  )}
</BaseLayout>

<script>
  const target = document.getElementById('confirm');
  if (target) {
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    const languages = JSON.parse(target.dataset['languages'] ?? '[]') as {
      code: string;
      native: string;
    }[];
    void import('../../account/confirm-start').then(({ start }) =>
      start(target, labels, languages)
    );
  }
</script>
