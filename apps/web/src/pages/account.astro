---
// Your account (M5 spec, step 3b): for teachers, coaches and parents. Off on the live site until
// the owner switches "accounts" on (Site settings); the drafts preview shows it for trying.
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
import { featureOn } from '../site';

const open = featureOn('accounts') || __RFA_SHOW_DRAFTS__;
const labels = Object.fromEntries(
  Object.entries(m)
    .filter(([key]) => key.startsWith('account_'))
    .map(([key, message]) => [key, (message as () => string)()])
);
---

<BaseLayout title={m.account_title()}>
  <h1>{m.account_title()}</h1>
  <p>{m.account_intro()}</p>
  {open ? (
    <>
      <div id="account" data-labels={JSON.stringify(labels)}>
        <p>{m.account_loading()}</p>
      </div>
      <p class="muted">{m.account_privacy()}</p>
    </>
  ) : (
    <p>{m.account_closed()}</p>
  )}
</BaseLayout>

<script>
  const target = document.getElementById('account');
  if (target) {
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    void import('../account/start').then(({ start }) => start(target, labels));
  }
</script>
