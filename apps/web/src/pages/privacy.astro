---
// Privacy page (M1 spec FR-11). Plain language; must stay true as features are added.
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
---

<BaseLayout title={m.privacy_title()}>
  <h1>{m.privacy_title()}</h1>
  <p>{m.privacy_intro()}</p>

  <h2>{m.privacy_collect_title()}</h2>
  <ul>
    <li>{m.privacy_collect_none()}</li>
    <li>{m.privacy_collect_no_tracking()}</li>
    <li>{m.privacy_collect_hosting()}</li>
  </ul>

  <h2>{m.privacy_device_title()}</h2>
  <p>{m.privacy_device_body()}</p>
  <p>{m.privacy_device_remove()}</p>

  <h2>{m.privacy_children_title()}</h2>
  <p>{m.privacy_children_body()}</p>

  <h2>{m.privacy_changes_title()}</h2>
  <p>{m.privacy_changes_body()}</p>
</BaseLayout>
