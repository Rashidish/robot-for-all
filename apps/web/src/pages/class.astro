---
// Learners (M5 step 5a, ADR-0013): sign in on a shared phone with the class code, nickname and picture PIN.
// Off on the live site until "accounts" is switched on.
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
import { featureOn } from '../site';

const open = featureOn('accounts') || __RFA_SHOW_DRAFTS__;
const labels = Object.fromEntries(
  Object.entries(m)
    .filter(([key]) => /^learner_|^enrol_avatar_/.test(key))
    .map(([key, message]) => [key, (message as () => string)()])
);
---

<BaseLayout title={m.learner_class_title()}>
  <h1>{m.learner_class_title()}</h1>
  {open ? (
    <div id="learner" data-which="signin" data-labels={JSON.stringify(labels)}>
      <p>{m.learner_loading()}</p>
    </div>
  ) : (
    <>
      <p>{m.enrol_soon()}</p>
      <p>
        <a href="/lessons/">{m.home_browse()}</a>
      </p>
    </>
  )}
</BaseLayout>

<script>
  const target = document.getElementById('learner');
  if (target) {
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    const which = target.dataset['which'] === 'me' ? 'me' : 'signin';
    void import('../learner/start').then(({ start }) => start(target, which, labels));
  }
</script>
