---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
---

<BaseLayout title={t('nav.about')}>
  <h1>{t('about.title')}</h1>
  <p>{t('about.mission')}</p>

  <h2>{t('about.how_title')}</h2>
  <ol>
    <li>{t('about.how_build')}</li>
    <li>{t('about.how_control')}</li>
    <li>{t('about.how_integrate')}</li>
  </ol>

  <h2>{t('about.who_title')}</h2>
  <p>{t('about.who_body')}</p>
</BaseLayout>
