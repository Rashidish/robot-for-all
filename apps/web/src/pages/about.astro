---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
---

<BaseLayout title={m.nav_about()}>
  <h1>{m.about_title()}</h1>
  <p>{m.about_mission()}</p>

  <h2>{m.about_how_title()}</h2>
  <ol>
    <li>{m.about_how_build()}</li>
    <li>{m.about_how_control()}</li>
    <li>{m.about_how_integrate()}</li>
  </ol>

  <h2>{m.about_who_title()}</h2>
  <p>{m.about_who_body()}</p>
</BaseLayout>
