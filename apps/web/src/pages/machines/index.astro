---
// The Machine library (machines spec FR-1): every topic, grouped by family.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localHref, m, pageLang } from '../../i18n';
import { familyName } from '../../machines/families';
import { getMachines } from '../../machines/load';
import { localMachine } from '../../machines/translations';
import { MACHINE_FAMILIES } from '../../machines/schema';

const topics = await getMachines();
// Each topic's title and card in the page's language where a translation may be shown (FR-10).
const local = new Map(
  await Promise.all(topics.map(async (t) => [t.id, await localMachine(t, pageLang())] as const))
);
const textLang = (id: string) => {
  const l = local.get(id)?.lang ?? 'en';
  return l === pageLang() ? undefined : l;
};
const families = MACHINE_FAMILIES.map((family) => ({
  family,
  topics: topics.filter((t) => t.data.family === family)
})).filter((f) => f.topics.length > 0);
const grades = [...new Set(topics.flatMap((t) => t.data.grades))].sort((a, b) => a - b);
---

<BaseLayout title={m.machines_title()}>
  <h1>{m.machines_title()}</h1>
  <p>{m.machines_intro()}</p>
  {topics.length === 0 && <p class="muted">{m.machines_empty()}</p>}
  {topics.length > 0 && (
    <form class="filters" data-machine-filters hidden aria-label={m.machines_filter_label()}>
      <label>
        {m.lessons_filter_grade()}
        <select name="grade">
          <option value="">{m.lessons_filter_any()}</option>
          {grades.map((g) => (
            <option value={g}>{g}</option>
          ))}
        </select>
      </label>
    </form>
  )}
  <p class="muted" data-machine-filter-none role="status" hidden>
    {m.machines_filter_none()}
  </p>
  {families.map(({ family, topics }) => (
    <section aria-labelledby={`family-${family}`} data-family>
      <h2 id={`family-${family}`}>{familyName(family)}</h2>
      {topics.map((topic) => (
        <article class="card" data-machine={topic.id} data-grades={topic.data.grades.join(' ')}>
          <h3>
            <a href={localHref(`/machines/${topic.id}/`)} lang={textLang(topic.id)}>
              {local.get(topic.id)?.data.title}
            </a>
          </h3>
          <p lang={textLang(topic.id)}>{local.get(topic.id)?.data.card}</p>
          <p class="meta">
            {m.lesson_grades({ grades: topic.data.grades.join('–') })}
            {topic.data.status !== 'published' && <> · {m.machine_draft_notice()}</>}
          </p>
        </article>
      ))}
    </section>
  ))}
</BaseLayout>

<script>
  // Grade filter (machines spec FR-1). Hidden without JavaScript, when every topic simply shows.
  const form = document.querySelector<HTMLFormElement>('[data-machine-filters]');
  const none = document.querySelector<HTMLElement>('[data-machine-filter-none]');
  if (form) {
    form.hidden = false;
    const select = form.elements.namedItem('grade');
    const apply = () => {
      const grade = select instanceof HTMLSelectElement ? select.value : '';
      let shown = 0;
      for (const section of document.querySelectorAll<HTMLElement>('[data-family]')) {
        let inSection = 0;
        for (const card of section.querySelectorAll<HTMLElement>('[data-machine]')) {
          const ok = !grade || (card.dataset['grades'] ?? '').split(' ').includes(grade);
          card.hidden = !ok;
          if (ok) inSection++;
        }
        section.hidden = inSection === 0;
        shown += inSection;
      }
      if (none) none.hidden = shown > 0;
    };
    form.addEventListener('change', apply);
  }
</script>

<style>
  .filters {
    margin-bottom: var(--space-4);
  }

  .filters[hidden],
  [data-machine-filter-none][hidden],
  [data-family][hidden],
  .card[hidden] {
    display: none;
  }

  label {
    display: flex;
    flex-direction: column;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  select {
    min-height: var(--tap);
    min-width: 7.5rem;
    max-width: 12rem;
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 400;
  }

  .card {
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  h3 {
    margin: 0 0 var(--space-2);
  }

  h3 a {
    display: inline-block;
    min-height: var(--tap);
    padding-top: var(--space-1);
  }

  .card p {
    margin: 0 0 var(--space-2);
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
