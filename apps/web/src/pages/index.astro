---
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
---

<BaseLayout>
  <h1>{m.app_tagline()}</h1>
  <p class="intro">{m.home_intro()}</p>
  <ul class="points">
    <li>{m.home_point_free()}</li>
    <li>{m.home_point_cheap()}</li>
    <li>{m.home_point_offline()}</li>
  </ul>
  <p class="muted">{m.home_coming_soon()}</p>
  <p>
    <a class="button" href="/about/">
      {m.home_learn_more()}
    </a>
  </p>
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-lg);
  }

  .points {
    padding-left: var(--space-6);
  }

  .points li {
    margin-bottom: var(--space-2);
  }
</style>
