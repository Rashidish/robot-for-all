---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
---

<BaseLayout>
  <h1>{t('app.tagline')}</h1>
  <p class="intro">{t('home.intro')}</p>
  <ul class="points">
    <li>{t('home.point_free')}</li>
    <li>{t('home.point_cheap')}</li>
    <li>{t('home.point_offline')}</li>
  </ul>
  <p class="muted">{t('home.coming_soon')}</p>
  <p>
    <a class="button" href="/about/">
      {t('home.learn_more')}
    </a>
  </p>
</BaseLayout>

<style>
  .intro {
    font-size: var(--text-lg);
  }

  .points {
    padding-left: var(--space-6);
  }

  .points li {
    margin-bottom: var(--space-2);
  }
</style>
