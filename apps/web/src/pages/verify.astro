---
// Check a certificate (M5 FR-29): anyone, without signing in. Off on the live site until
// "accounts" is switched on (there are no codes before then).
import BaseLayout from '../layouts/BaseLayout.astro';
import { m } from '../i18n';
import { featureOn } from '../site';

const open = featureOn('accounts') || __RFA_SHOW_DRAFTS__;
const labels = Object.fromEntries(
  Object.entries(m)
    .filter(([key]) => /^(verify|badge)_/.test(key))
    .map(([key, message]) => [key, (message as () => string)()])
);
---

<BaseLayout title={m.verify_title()}>
  <h1>{m.verify_title()}</h1>
  <p>{m.verify_intro()}</p>
  {open ? (
    <div id="verify" data-labels={JSON.stringify(labels)}>
      <p>{m.account_loading()}</p>
    </div>
  ) : (
    <p>{m.enrol_soon()}</p>
  )}
</BaseLayout>

<script>
  const target = document.getElementById('verify');
  if (target) {
    const labels = JSON.parse(target.dataset['labels'] ?? '{}') as Record<string, string>;
    void Promise.all([import('svelte'), import('../components/Verify.svelte')]).then(
      ([{ mount }, { default: Verify }]) => {
        target.replaceChildren();
        mount(Verify, { target, props: { labels } });
      }
    );
  }
</script>
