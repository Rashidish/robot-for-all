---
// Template page (M2 spec FR-7): view, print at true size, or draw by hand from the measurements.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PrintButton from '../../../../components/PrintButton.astro';
import { localHref, m, pageLang } from '../../../../i18n';
import { localLesson } from '../../../../lessons/translations';
import { hidden } from '../../../../withdrawn';
import { getLessons, type LessonEntry } from '../../../../lessons/load';
import {
  findTemplate,
  templateFile,
  templateMeasurements,
  type TemplateEntry
} from '../../../../templates/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.flatMap((lesson) =>
    lesson.data.templates
      .filter((name) => !hidden('template', `${lesson.id}/${name}`))
      .map((name) => ({
        params: { lesson: lesson.id, name },
        props: { lesson, lessons, entry: findTemplate(lesson.id, name) }
      }))
  );
}

interface Props {
  lesson: LessonEntry;
  lessons: LessonEntry[];
  entry: TemplateEntry;
}

const { lesson, lessons, entry } = Astro.props;
// The sheet in this page's language when its lesson translation may be shown (spec §2.3);
// otherwise the English sheet, marked as English.
const local = await localLesson(lesson, pageLang(), lessons);
const words = local.lang === pageLang() ? local.sheets[entry.name] : undefined;
const sheetLang = words || pageLang() === 'en' ? pageLang() : 'en';
const textLang = sheetLang === pageLang() ? undefined : sheetLang;
const title = words?.title ?? entry.sheet.title;
const file = templateFile(entry.lesson, entry.name, sheetLang);
const lessonTitle = local.data.title;
---

<BaseLayout title={title}>
  <div class="template-info">
    <p class="back">
      <a
        href={localHref(`/lessons/${entry.lesson}/`)}
        lang={local.lang === pageLang() ? undefined : local.lang}
      >
        ← {lessonTitle}
      </a>
    </p>
    <h1 lang={textLang}>{title}</h1>
    <p>{m.template_print_hint()}</p>
    <PrintButton label={m.template_print()} />
    <p>
      <a href={file} download>
        {m.template_download()}
      </a>
    </p>
  </div>

  <img class="sheet" src={file} alt={title} lang={textLang} width="210" height="297" />

  <section class="template-info" aria-labelledby="measure-title">
    <h2 id="measure-title">{m.template_measurements_title()}</h2>
    <ul lang={textLang}>
      {templateMeasurements(entry, sheetLang, words).map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style is:global>
  .sheet {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-4) 0;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    .template-info,
    .skip-link {
      display: none !important;
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      margin: 0;
      border: 0;
    }
  }
</style>
