---
// Template page (M2 spec FR-7): view, print at true size, or draw by hand from the measurements.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PrintButton from '../../../../components/PrintButton.astro';
import { m } from '../../../../i18n';
import { hidden } from '../../../../withdrawn';
import { getLessons } from '../../../../lessons/load';
import {
  findTemplate,
  templateFile,
  templateMeasurements,
  type TemplateEntry
} from '../../../../templates/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.flatMap((lesson) =>
    lesson.data.templates
      .filter((name) => !hidden('template', `${lesson.id}/${name}`))
      .map((name) => ({
        params: { lesson: lesson.id, name },
        props: { lessonTitle: lesson.data.title, entry: findTemplate(lesson.id, name) }
      }))
  );
}

interface Props {
  lessonTitle: string;
  entry: TemplateEntry;
}

const { lessonTitle, entry } = Astro.props;
const file = templateFile(entry.lesson, entry.name);
---

<BaseLayout title={entry.sheet.title}>
  <div class="template-info">
    <p class="back">
      <a href={`/lessons/${entry.lesson}/`}>← {lessonTitle}</a>
    </p>
    <h1>{entry.sheet.title}</h1>
    <p>{m.template_print_hint()}</p>
    <PrintButton label={m.template_print()} />
    <p>
      <a href={file} download>
        {m.template_download()}
      </a>
    </p>
  </div>

  <img class="sheet" src={file} alt={entry.sheet.title} width="210" height="297" />

  <section class="template-info" aria-labelledby="measure-title">
    <h2 id="measure-title">{m.template_measurements_title()}</h2>
    <ul>
      {templateMeasurements(entry).map((line) => (
        <li>{line}</li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style is:global>
  .sheet {
    display: block;
    width: 100%;
    height: auto;
    margin: var(--space-4) 0;
    border: 1px solid var(--color-border);
    background: #fff;
  }

  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    .template-info,
    .skip-link {
      display: none !important;
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      margin: 0;
      border: 0;
    }
  }
</style>
