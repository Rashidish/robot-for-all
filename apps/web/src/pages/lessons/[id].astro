---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadLesson from '../../components/DownloadLesson.astro';
import PrintButton from '../../components/PrintButton.astro';
import { findTemplate, templateFile, templatePage } from '../../templates/load';
import { starterLink } from '../../lessons/programs';
import { m } from '../../i18n';
import { getLessons, type LessonEntry } from '../../lessons/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  const titles = Object.fromEntries(lessons.map((l) => [l.id, l.data.title]));
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson, titles } }));
}

interface Props {
  lesson: LessonEntry;
  /** Titles of the lessons visible in this build, for prerequisite and next links. */
  titles: Record<string, string>;
}

const { lesson, titles } = Astro.props;
const prerequisites = lesson.data.prerequisites.filter((id) => titles[id]);
const next = lesson.data.next && titles[lesson.data.next] ? lesson.data.next : null;
const { data } = lesson;
const { Content } = await render(lesson);
const sheets = data.templates.flatMap((name) => findTemplate(lesson.id, name) ?? []);
const starter = data.starter_program ? starterLink(lesson.id, data.starter_program) : undefined;
---

<BaseLayout title={data.title}>
  <p class="back">
    <a href="/lessons/">← {m.lesson_back()}</a>
  </p>

  {data.status !== 'published' && (
    <p class="draft" role="note">
      {m.lesson_draft_notice()}
    </p>
  )}

  <h1>{data.title}</h1>

  <ul class="facts">
    <li>{m.lesson_phase({ phase: data.phase })}</li>
    <li>{m.lesson_grades({ grades: data.grades.join('–') })}</li>
    <li>{m.lesson_duration({ minutes: data.duration_minutes })}</li>
    <li>{m.lesson_cost({ amount: data.cost_estimate_zar })}</li>
    <li>{m.lesson_mechanism({ mechanism: data.mechanism })}</li>
  </ul>

  <p>
    <a class="button" href={`/lessons/${lesson.id}/slides/`} data-offline>
      {m.lesson_slides_link()}
    </a>
  </p>

  <DownloadLesson />

  <section
    class:list={['safety', { 'adult-help': data.safety.adult_help }]}
    aria-labelledby="safety-title"
  >
    <h2 id="safety-title">⚠ {m.lesson_safety_title()}</h2>
    {data.safety.adult_help && <p class="adult">{m.lesson_adult_help()}</p>}
    <ul>
      {data.safety.notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="outcomes-title">
    <h2 id="outcomes-title">{m.lesson_outcomes_title()}</h2>
    <ul>
      {data.outcomes.map((outcome) => (
        <li>{outcome}</li>
      ))}
    </ul>
    {data.concepts.length > 0 && (
      <p class="concepts">
        <strong>{m.lesson_concepts_title()}:</strong> {data.concepts.join(', ')}
      </p>
    )}
  </section>

  {prerequisites.length > 0 && (
    <section aria-labelledby="prereq-title">
      <h2 id="prereq-title">{m.lesson_prerequisites_title()}</h2>
      <ul>
        {prerequisites.map((id) => (
          <li>
            <a href={`/lessons/${id}/`}>{titles[id]}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {starter && (
    <section class="code-start" aria-labelledby="code-start-title">
      <h2 id="code-start-title">{m.lesson_code_title()}</h2>
      <p>
        {data.hardware === 'none'
          ? m.lesson_code_no_hardware()
          : data.hardware === 'microbit'
            ? m.lesson_code_microbit()
            : m.lesson_code_microbit_motor()}
      </p>
      <p>
        <a class="button" href={starter}>
          {m.lesson_open_in_editor()}
        </a>
      </p>
    </section>
  )}

  <section class="parts" aria-labelledby="parts-title">
    <h2 id="parts-title">{m.lesson_parts_title()}</h2>
    <ul>
      {data.parts.map((part) => (
        <li>
          {part.qty} × {part.item}
          {part.substitute && (
            <span class="muted"> ({m.lesson_substitute({ substitute: part.substitute })})</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  {sheets.length > 0 && (
    <section class="templates" aria-labelledby="templates-title">
      <h2 id="templates-title">{m.lesson_templates_title()}</h2>
      <ul>
        {sheets.map((t) => (
          <li>
            <a href={templatePage(t.lesson, t.name)} data-offline>
              {t.sheet.title}
            </a>
            <a class="muted" href={templateFile(t.lesson, t.name)} data-offline download>
              ({m.template_download()})
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="lesson-body">
    <Content />
  </div>

  <section class="assessment" aria-labelledby="assessment-title">
    <h2 id="assessment-title">{m.lesson_assessment_title()}</h2>
    <ul>
      {data.assessment.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  {data.syllabus_links.length > 0 && (
    <section aria-labelledby="syllabus-title">
      <h2 id="syllabus-title">{m.lesson_syllabus_title()}</h2>
      <ul>
        {data.syllabus_links.map((link) => (
          <li>
            {link.subject}: {link.topic}
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && (
    <p class="next">
      <strong>{m.lesson_next_title()}:</strong> <a href={`/lessons/${next}/`}>{titles[next]}</a>
    </p>
  )}

  <PrintButton label={m.lesson_print()} />
</BaseLayout>

<style>
  .back {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .draft {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    font-weight: 600;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .parts {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .parts h2,
  .code-start h2 {
    margin-top: 0;
  }

  .code-start {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
  }

  .safety {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
  }

  .safety.adult-help {
    border-color: var(--color-accent);
  }

  .safety h2 {
    margin-top: 0;
  }

  .safety .adult {
    font-weight: 700;
  }

  .assessment ul {
    list-style: '☐  ';
  }

  .next {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  button.button {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  @media print {
    .back,
    .code-start .button {
      display: none !important;
    }

    .facts li,
    .parts {
      border-color: #999;
    }

    .lesson-body h2 {
      break-after: avoid;
    }

    .parts,
    .lesson-body p {
      break-inside: avoid;
    }
  }
</style>
