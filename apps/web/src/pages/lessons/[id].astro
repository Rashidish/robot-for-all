---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DownloadLesson from '../../components/DownloadLesson.astro';
import { m } from '../../i18n';
import { getLessons, type LessonEntry } from '../../lessons/load';

export async function getStaticPaths() {
  const lessons = await getLessons();
  const titles = Object.fromEntries(lessons.map((l) => [l.id, l.data.title]));
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson, titles } }));
}

interface Props {
  lesson: LessonEntry;
  /** Titles of the lessons visible in this build, for prerequisite and next links. */
  titles: Record<string, string>;
}

const { lesson, titles } = Astro.props;
const prerequisites = lesson.data.prerequisites.filter((id) => titles[id]);
const next = lesson.data.next && titles[lesson.data.next] ? lesson.data.next : null;
const { data } = lesson;
const { Content } = await render(lesson);
---

<BaseLayout title={data.title}>
  <p class="back">
    <a href="/lessons/">← {m.lesson_back()}</a>
  </p>

  {data.status !== 'published' && (
    <p class="draft" role="note">
      {m.lesson_draft_notice()}
    </p>
  )}

  <h1>{data.title}</h1>

  <ul class="facts">
    <li>{m.lesson_phase({ phase: data.phase })}</li>
    <li>{m.lesson_grades({ grades: data.grades.join('–') })}</li>
    <li>{m.lesson_duration({ minutes: data.duration_minutes })}</li>
    <li>{m.lesson_cost({ amount: data.cost_estimate_zar })}</li>
    <li>{m.lesson_mechanism({ mechanism: data.mechanism })}</li>
  </ul>

  <DownloadLesson />

  <section
    class:list={['safety', { 'adult-help': data.safety.adult_help }]}
    aria-labelledby="safety-title"
  >
    <h2 id="safety-title">⚠ {m.lesson_safety_title()}</h2>
    {data.safety.adult_help && <p class="adult">{m.lesson_adult_help()}</p>}
    <ul>
      {data.safety.notes.map((note) => <li>{note}</li>)}
    </ul>
  </section>

  <section aria-labelledby="outcomes-title">
    <h2 id="outcomes-title">{m.lesson_outcomes_title()}</h2>
    <ul>
      {data.outcomes.map((outcome) => <li>{outcome}</li>)}
    </ul>
    {data.concepts.length > 0 && (
      <p class="concepts">
        <strong>{m.lesson_concepts_title()}:</strong> {data.concepts.join(', ')}
      </p>
    )}
  </section>

  {prerequisites.length > 0 && (
    <section aria-labelledby="prereq-title">
      <h2 id="prereq-title">{m.lesson_prerequisites_title()}</h2>
      <ul>
        {prerequisites.map((id) => (
          <li>
            <a href={`/lessons/${id}/`}>{titles[id]}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="parts" aria-labelledby="parts-title">
    <h2 id="parts-title">{m.lesson_parts_title()}</h2>
    <ul>
      {data.parts.map((part) => (
        <li>
          {part.qty} × {part.item}
          {part.substitute && (
            <span class="muted"> ({m.lesson_substitute({ substitute: part.substitute })})</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <div class="lesson-body">
    <Content />
  </div>

  <section class="assessment" aria-labelledby="assessment-title">
    <h2 id="assessment-title">{m.lesson_assessment_title()}</h2>
    <ul>
      {data.assessment.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  {data.syllabus_links.length > 0 && (
    <section aria-labelledby="syllabus-title">
      <h2 id="syllabus-title">{m.lesson_syllabus_title()}</h2>
      <ul>
        {data.syllabus_links.map((link) => (
          <li>
            {link.subject}: {link.topic}
          </li>
        ))}
      </ul>
    </section>
  )}

  {next && (
    <p class="next">
      <strong>{m.lesson_next_title()}:</strong> <a href={`/lessons/${next}/`}>{titles[next]}</a>
    </p>
  )}

  <p>
    <button type="button" class="button" data-print hidden>
      {m.lesson_print()}
    </button>
  </p>
</BaseLayout>

<script>
  // Progressive enhancement: the print button only appears when JavaScript runs.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }
</script>

<style>
  .back {
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .draft {
    padding: var(--space-3) var(--space-4);
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    font-weight: 600;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  .parts {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .parts h2 {
    margin-top: 0;
  }

  .safety {
    margin: var(--space-6) 0;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
  }

  .safety.adult-help {
    border-color: var(--color-accent);
  }

  .safety h2 {
    margin-top: 0;
  }

  .safety .adult {
    font-weight: 700;
  }

  .assessment ul {
    list-style: '☐  ';
  }

  .next {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  button.button {
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  @media print {
    .back,
    [data-print] {
      display: none !important;
    }

    .facts li,
    .parts {
      border-color: #999;
    }

    .lesson-body h2 {
      break-after: avoid;
    }

    .parts,
    .lesson-body p {
      break-inside: avoid;
    }
  }
</style>
