---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LessonCard from '../../components/LessonCard.astro';
import LessonFilters from '../../components/LessonFilters.astro';
import { m, pageLang } from '../../i18n';
import { getLessons } from '../../lessons/load';
import { localLesson } from '../../lessons/translations';
import { getMachines } from '../../machines/load';

const lessons = await getLessons();
const machines = (await getMachines()).map((t) => ({ id: t.id, title: t.data.title }));
// Titles in this page's language where a translation may be shown (spec §2.7).
const local = await Promise.all(lessons.map((l) => localLesson(l, pageLang(), lessons)));
---

<BaseLayout title={m.lessons_title()}>
  <h1>{m.lessons_title()}</h1>
  <p>{m.lessons_intro()}</p>
  {lessons.length > 0 && <LessonFilters lessons={lessons} machines={machines} />}
  {lessons.length === 0 ? (
    <p class="muted">{m.lessons_empty()}</p>
  ) : (
    lessons.map((lesson, i) => {
      const view = local[i];
      return (
        <LessonCard
          lesson={lesson}
          title={view?.data.title ?? lesson.data.title}
          titleLang={view && view.lang !== pageLang() ? view.lang : undefined}
        />
      );
    })
  )}
</BaseLayout>
