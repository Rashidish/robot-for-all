---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localHref, m } from '../i18n';
---

<BaseLayout title={m.notfound_title()}>
  <h1>{m.notfound_title()}</h1>
  <p>{m.notfound_body()}</p>
  <p>
    <a class="button" href={localHref('/')}>
      {m.notfound_home()}
    </a>
  </p>
</BaseLayout>
