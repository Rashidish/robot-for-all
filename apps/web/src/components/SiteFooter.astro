---
import { m } from '../i18n';
---

<footer class="site-footer">
  <p>{m.footer_promise()}</p>
  <p class="muted">{m.footer_licence()}</p>
  <p><a href="/privacy/">{m.nav_privacy()}</a></p>
</footer>

<style>
  .site-footer {
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: var(--text-sm);
    text-align: center;
  }

  .site-footer p {
    margin: 0 0 var(--space-1);
  }
</style>
