---
// Simple robot-head mark drawn in currentColor, so it follows light/dark mode.
// Decorative: the brand name always sits next to it as text.
---

<svg
  width="32"
  height="32"
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <line x1="16" y1="3" x2="16" y2="8"></line>
  <circle cx="16" cy="3" r="1.5" fill="currentColor"></circle>
  <rect x="5" y="8" width="22" height="17" rx="4"></rect>
  <circle cx="12" cy="16" r="2" fill="currentColor"></circle>
  <circle cx="20" cy="16" r="2" fill="currentColor"></circle>
  <line x1="12" y1="21" x2="20" y2="21"></line>
  <line x1="9" y1="25" x2="9" y2="29"></line>
  <line x1="23" y1="25" x2="23" y2="29"></line>
</svg>
