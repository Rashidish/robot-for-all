---
// The announcement banner from the back office (spec §6.7). It is in the page when one is set,
// hidden until a tiny script checks today's South African date is in its range and the learner
// hasn't closed it. Without JavaScript it stays hidden, so it never shows out of date.
import { bannerId, bannerText } from '../../../../packages/settings/src/site';
import { lang, m } from '../i18n';
import { site } from '../site';

const a = site.announcement;
---

{a && (
  <div
    class="banner"
    role="region"
    aria-label={m.banner_label()}
    data-banner
    data-from={a.from}
    data-to={a.to}
    data-id={bannerId(a)}
    hidden
  >
    <p>
      {bannerText(a, lang)}
      {a.link && (
        <>
          {' '}
          <a href={a.link}>{m.banner_more()}</a>
        </>
      )}
    </p>
    <button type="button" class="banner-close" data-banner-close aria-label={m.banner_close()}>
      ×
    </button>
  </div>
)}

<script>
  import { setupBanner } from '../banner';

  const banner = document.querySelector<HTMLElement>('[data-banner]');
  if (banner) {
    let storage: Storage | null = null;
    try {
      storage = localStorage;
    } catch {
      // Storage blocked.
    }
    setupBanner(banner, new Date(), storage);
  }
</script>

<style>
  .banner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .banner[hidden] {
    display: none;
  }

  .banner p {
    flex: 1;
    margin: 0;
  }

  .banner a {
    color: inherit;
    font-weight: 600;
  }

  .banner-close {
    flex: none;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
