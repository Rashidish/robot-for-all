// The back-office Worker (ADR-0011). Deployed by .github/workflows/deploy.yml from main only.
// Secrets (SUPABASE_URL, SUPABASE_ANON_KEY, ACCESS_TEAM, ACCESS_AUD) are set with
// `wrangler secret put`, never written here.
{
  "name": "robots-for-all-admin",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "admin.robotsforall.org.za", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
